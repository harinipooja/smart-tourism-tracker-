# ---------------------------------------------------------------------------
# Smart Tourism Website - environment variables
# Copy this file to `.env` and fill in the values you own.
# EVERY integration below is OPTIONAL: the app falls back to clearly-labelled
# demonstration data when a key is missing, so it always runs locally.
# ---------------------------------------------------------------------------

# ----- Database (PostgreSQL + Prisma) --------------------------------------
# Optional. When set, the Express API persists users/bookings/reviews in
# PostgreSQL. When empty, the API uses a seeded in-memory store instead.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smart_tourism?schema=public"

# ----- Auth -----------------------------------------------------------------
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# ----- Backend API ----------------------------------------------------------
API_PORT=4000
CORS_ORIGIN="http://localhost:3000"

# Public base URL the browser uses to reach the Express API.
NEXT_PUBLIC_API_BASE="http://localhost:4000/api"

# ----- OpenAI (AI Travel Assistant) ----------------------------------------
# When missing, the assistant answers using a built-in rule-based engine.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# ----- Google Maps Platform -------------------------------------------------
# When missing, the interactive map shows a stylised fallback map view.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# ----- Amadeus Travel API ---------------------------------------------------
# When missing, flight/hotel search returns clearly-labelled demo data.
AMADEUS_CLIENT_ID=""
AMADEUS_CLIENT_SECRET=""
AMADEUS_ENV="test"
